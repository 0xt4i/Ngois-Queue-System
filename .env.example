# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Khoá công khai (anon JWT "eyJ..." hoặc publishable "sb_publishable_...") — chỉ dùng để nhận realtime
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Khoá bí mật (service_role JWT hoặc "sb_secret_...") — CHỈ dùng phía server, KHÔNG để lộ
SUPABASE_SERVICE_ROLE_KEY=

# Tiệm mặc định khi mở "/"
NEXT_PUBLIC_DEFAULT_SHOP_SLUG=demo-photobooth

# (tuỳ chọn) URL công khai của web, dùng cho QR. Mặc định lấy từ request.
NEXT_PUBLIC_APP_URL=

# (chỉ dùng khi chạy test local) kết nối thẳng Postgres của `supabase start`
DATABASE_URL_TEST=postgresql://postgres:postgres@127.0.0.1:54322/postgres
